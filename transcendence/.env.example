# =============================================================================
# ft_transcendence — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development

# Server name used by Nginx for SSL cert generation
SERVER_NAME=localhost

# -----------------------------------------------------------------------------
# JWT Authentication
# Must be the SAME value across all services — they all verify the same tokens
# Use a long random string in production: openssl rand -hex 64
# -----------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_secret

# Internal service-to-service auth token (used by user-service → database-service)
DB_SERVICE_TOKEN=super_secret_internal_token

# Session cookie max age in seconds (default: 3600 = 1 hour)
COOKIE_MAX_AGE=3600

# -----------------------------------------------------------------------------
# Service URLs (internal Docker network — don't expose these ports)
# -----------------------------------------------------------------------------
USER_SERVICE_URL=http://user-service:3001
GAME_SERVICE_URL=http://game-service:3002
LOG_SERVICE_URL=http://log-service:3003
TOURNAMENT_SERVICE_URL=http://tournament-service:3005
DATABASE_SERVICE_URL=http://database-service:3006

# Frontend URL — used by gateway for CORS
FRONT_END_URL=http://localhost:3004

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
GAME_SERVICE_PORT=3002
LOG_SERVICE_PORT=3003
FRONTEND_PORT=3004
TOURNAMENT_SERVICE_PORT=3005
DATABASE_SERVICE_PORT=3006

GAME_SERVICE_HOST=game-service

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:/app/shared/database/transcendence.db

# -----------------------------------------------------------------------------
# Nginx
# -----------------------------------------------------------------------------
GATEWAY_HOST=gateway
CLIENT_MAX_BODY_SIZE=10M

# -----------------------------------------------------------------------------
# Vite / Frontend (these are injected at build time — prefix with VITE_)
# -----------------------------------------------------------------------------
VITE_API_BASE=http://localhost:3000/user-service
VITE_GATEWAY_BASE=http://localhost:3000
VITE_WS_BASE=ws://localhost:3000

# -----------------------------------------------------------------------------
# ELK Stack (only used with: make or make start-monitoring)
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=http://elasticsearch:9200
LOGSTASH_URL=http://logstash:5000
KIBANA_URL=http://localhost:5601

# JVM heap for Logstash — keep low on school machines
LS_JAVA_OPTS=-Xms256m -Xmx256m

# Kibana encryption keys — generate with: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=change_me_32_char_kibana_encryption_key_here
KIBANA_REPORTING_KEY=change_me_32_char_kibana_reporting_key_here
KIBANA_SECURITY_KEY=change_me_32_char_kibana_security_key_here